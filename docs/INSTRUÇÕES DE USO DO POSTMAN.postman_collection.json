                  "const json = pm.response.json();",
                  "if (json.urlRecoverPassword) {",
                  "  const url = new URL(json.urlRecoverPassword);",
                  "  const email = url.searchParams.get('email');",
                  "  const key = url.searchParams.get('key');",
                  "  if (email) pm.collectionVariables.set('recoverEmail', email);",
                  "  if (key) pm.collectionVariables.set('recoverKey', key);",
                  "}"
